{
  "name": "aetheria-cartographer",
  "productName": "Aetheria Cartographer",
  "version": "0.9.0",
  "description": "Offline fantasy map editor for tabletop RPGs — world, operational, city, castle, dungeon, cave and battle maps, with first-class Foundry VTT and Universal VTT export.",
  "author": {
    "name": "Nikita Balandin",
    "email": "nikitav.balandin@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env AETHERIA_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.aetheria.cartographer",
    "productName": "Aetheria Cartographer",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "resources/icon.png",
      "maintainer": "Nikita Balandin <nikitav.balandin@gmail.com>",
      "synopsis": "Offline fantasy map editor for tabletop RPGs",
      "desktop": {
        "Name": "Aetheria Cartographer",
        "Categories": "Graphics;Game;"
      }
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://example.invalid/aetheria-cartographer.git"
  }
}
